# ---------------------------------------------------------------------------
# Model. Any OpenAI-compatible endpoint works: set the base URL, the key, and
# the model name. Pick one recipe below and delete the rest.
# ---------------------------------------------------------------------------

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-replace-me
MODEL_NAME=gpt-4o-mini

# Groq            OPENAI_BASE_URL=https://api.groq.com/openai/v1              MODEL_NAME=llama-3.3-70b-versatile
# OpenRouter      OPENAI_BASE_URL=https://openrouter.ai/api/v1                MODEL_NAME=openai/gpt-4o-mini
# Together        OPENAI_BASE_URL=https://api.together.xyz/v1                 MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct-Turbo
# DeepSeek        OPENAI_BASE_URL=https://api.deepseek.com/v1                 MODEL_NAME=deepseek-chat
# Mistral         OPENAI_BASE_URL=https://api.mistral.ai/v1                   MODEL_NAME=mistral-large-latest
# Ollama          OPENAI_BASE_URL=http://host.docker.internal:11434/v1        MODEL_NAME=qwen3:8b          OPENAI_API_KEY=ollama
# LM Studio       OPENAI_BASE_URL=http://host.docker.internal:1234/v1         MODEL_NAME=<loaded model>    OPENAI_API_KEY=lm-studio
# vLLM / TGI      OPENAI_BASE_URL=http://host.docker.internal:8001/v1         MODEL_NAME=<served model>    OPENAI_API_KEY=local
#
# From inside Docker, a provider running on your own machine is reachable at
# host.docker.internal, never at localhost.
#
# The tool loop needs native function calling. A model without it will answer but
# never call remember / recall / run_python / publish_note.

# Azure OpenAI is NOT plain OpenAI-compatible. Set the endpoint below instead of
# OPENAI_BASE_URL; MODEL_NAME is then your *deployment* name, not the model name.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21

# Verifier subagent: a second, cheaper model that checks each answer. It needs
# typed output. Point it at a capable model, or set VERIFIER_ENABLED=0 on an
# endpoint that cannot do structured output.
# VERIFIER_MODEL_NAME=gpt-4o-mini
VERIFIER_ENABLED=1

# Run the whole loop with no provider at all: real tools, real sandbox, real
# memory, fake model. Useful for demos and for testing without spend.
FAKE_MODEL=0
FAKE_MODEL_TOOLS=recall,run_python

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Sandbox isolation. "" is the default docker runtime: containers share the host kernel,
# which is NOT the boundary the design doc asks for. runsc (gVisor) or kata give a real one.
#   gVisor: install runsc, add {"runtimes":{"runsc":{"path":"/usr/local/bin/runsc"}}} to
#   /etc/docker/daemon.json, restart docker, then set SANDBOX_RUNTIME=runsc.
SANDBOX_RUNTIME=
SANDBOX_MEM_LIMIT=512m

# Warm pools. An actor is mapped to a pool by crc32(actor) % SANDBOX_POOL_COUNT, so its
# sessions always share one ceiling.
SANDBOX_POOL_SIZE=2
SANDBOX_POOL_COUNT=1
SANDBOX_MAX_CONCURRENT=20
# autosize the warm depth by Little's Law (arrival rate x start latency), capped by POOL_MAX
SANDBOX_AUTOSIZE=0
SANDBOX_POOL_MAX=8

# Two session limits, both from the design doc.
SANDBOX_COOLDOWN_SECONDS=300
SANDBOX_MAX_LIFETIME_SECONDS=3600

# Two-phase start: this command runs once WITH network, then egress is revoked for the life
# of the container. Install to /workspace/libs; it is on PYTHONPATH and the rootfs is read-only.
#   SANDBOX_SETUP_CMD=pip install --quiet --target /workspace/libs pandas
SANDBOX_SETUP_CMD=
EPISODE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=20
MODEL_TIMEOUT_SECONDS=60
# Step budget per turn. A chat reply needs a handful of requests; a ten-step brief needs tens.
# Too low and a long task stops halfway and returns status: degraded.
JOURNEY_REQUEST_LIMIT=30
JOURNEY_TOOL_CALLS_LIMIT=60
# SCHEDULE_ENABLED=1
# SCHEDULE_MINUTES=15
