# Server configuration
PORT=8000

# Database
MONGO_URL=mongodb://your-database-url

# JWT Secrets
JWT_SECRET=your-jwt-secret
JWT_SECRET_REMEMBER_ME=your-jwt-remember-me-secret

# File storage provider: s3 (default) or azure
STORAGE_BACKEND=s3

# S3-compatible storage (STORAGE_BACKEND=s3)
# Leave S3_ENDPOINT_URL empty for AWS.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=your-s3-bucket-name
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_REGION=us-east-1

# Azure Storage (STORAGE_BACKEND=azure)
AZURE_STORAGE_CONTAINER_NAME=your-azure-storage-container-name
AZURE_STORAGE_ACCOUNT_NAME=your-azure-storage-account-name

# PIN secret
PIN_SECRET_KEY=your-pin-secret-key
# Seconds between Forgot/Resend PIN SMS (default 120)
PIN_RESEND_COOLDOWN_SECONDS=120
# Delay after a wrong pending/forgot PIN attempt (default 10)
PIN_WRONG_DELAY_SECONDS=10

# Variform integration
VARIFORM_BEARER_TOKEN=your-variform-bearer-token
VARIFORM_SMS_TEMPLATE=your-sms-template-id
VARIFORM_SMS_WELCOME_TEMPLATE=your-welcome-sms-template-id
VARIFORM_SENDER_ID=your-sender-id
VARIFORM_SMS_TYPE=your-sms-type
VARIFORM_SMS_URL=your-sms-url

# LLM api
LLM_API_BASE_URL=your-llm-api-base-url
LLM_CHECKLIST_URL=your-checklist-url
LLM_EMBEDDING_URL=your-embedding-url
LLM_DURABLE_URL=your-durable-url
LLM_WORKFLOW_URL=your-workflow-url

# Superset embedded dashboard
SUPERSET_URL=http://your-superset-host:8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=your-superset-admin-password
SUPERSET_DASHBOARD_UUID=your-dashboard-uuid
SUPERSET_MOBILE_DASHBOARD_UUID=your-mobile-dashboard-uuid

# Application settings
SIMILARITY_THRESHOLD=0.98
CACHE_USAGE_RATE=0.9
CACHE_QUESTION_PER_TYPE=10
TURNSTILE_SECRET_KEY=
BASELINE_SURVEY=false
ENDLINE_SURVEY=false
