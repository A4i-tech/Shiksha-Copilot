# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

location            = "centralindia"
resource_group_name = "shiksha-superset-rg"
cluster_name        = "shiksha-superset-aks"
kubernetes_version  = "1.30"

# Node pool
node_vm_size        = "Standard_D2s_v3"   # 2 vCPU / 8 GB — good for staging
node_disk_size_gb   = 50
enable_auto_scaling = true
min_node_count      = 2
max_node_count      = 5

# ACR — must be globally unique, alphanumeric only, 5-50 chars
acr_name            = "shikshasupersetacr"

tags = {
  project    = "shiksha-copilot"
  component  = "superset"
  managed_by = "terraform"
  env        = "staging"
}
