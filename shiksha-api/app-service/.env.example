# Shiksha Copilot API Environment Configuration

# Application Settings
DEBUG=False
APP_NAME="Shiksha Copilot Fast API"
HOST=0.0.0.0
PORT=8000

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Custom endpoint - required for non-OpenAI providers (Gemini, Grok, local proxy).
# NOTE: two env vars must point to the same value.
# The OpenAI SDK reads OPENAI_BASE_URL, llama-index (used for RAG) reads OPENAI_API_BASE.
OPENAI_BASE_URL=
OPENAI_API_BASE=

# Optional model overrides
EMBED_MODEL=text-embedding-ada-002
GENERAL_CHAT_MODEL=gpt-5.6-luna
LESSON_CHAT_MODEL=gpt-5.6-luna
QUESTION_PAPER_MODEL=deepseek-v4-flash

# Blob Storage Configuration
BLOB_STORE_CONNECTION_STRING=your_blob_storage_connection_string_here

# Logging
LOG_LEVEL=INFO

QDRANT_URL=
QDRANT_API_KEY=

# Langfuse Observability (optional)
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Application environment (used to tag traces in Langfuse)
APP_ENV=local

# Translation
# Provider: openai (default) or azure. Any other value stops start-up.
TRANSLATION_PROVIDER=openai
# Base URL of an OpenAI-compatible server. Empty falls back to OPENAI_BASE_URL.
TRANSLATION_BASE_URL=
# API key for that server. Empty falls back to OPENAI_API_KEY.
TRANSLATION_API_KEY=
# Model name. Required when TRANSLATION_PROVIDER=openai.
TRANSLATION_MODEL=
# Azure Translator settings. Required when TRANSLATION_PROVIDER=azure.
TRANSLATOR_KEY=
TRANSLATOR_REGION=
TRANSLATOR_ENDPOINT=
