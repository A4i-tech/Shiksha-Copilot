# Shiksha Copilot API Environment Configuration

# Application Settings
DEBUG=False
APP_NAME="Shiksha Copilot Fast API"
HOST=0.0.0.0
PORT=8000

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Base URL of an OpenAI-compatible server (vLLM, Gemini, Grok, local proxy).
# Empty means public OpenAI. app-service supports public OpenAI and OpenAI-compatible servers only.
# OPENAI_API_BASE is the llama-index name for the same value and is accepted as an alias.
OPENAI_BASE_URL=
# Each kind can use its own server. An empty value falls back to OPENAI_BASE_URL.
CHAT_BASE_URL=
EMBEDDING_BASE_URL=

# Chat API for the chat calls: responses or chat_completions.
# Empty means responses when the chat base URL is empty (public OpenAI),
# and chat_completions when the chat base URL or OPENAI_BASE_URL is set.
# The hosted web search in the general chat exists only on responses with public OpenAI.
CHAT_API=
# Context window for a self-hosted chat model that llama-index does not know. Empty uses 32768.
LLM_CONTEXT_WINDOW=

# Optional model overrides
EMBED_MODEL=text-embedding-ada-002
GENERAL_CHAT_MODEL=gpt-5.6-luna
LESSON_CHAT_MODEL=gpt-5.6-luna
QUESTION_PAPER_MODEL=deepseek-v4-flash

# Blob Storage Configuration
BLOB_STORE_CONNECTION_STRING=your_blob_storage_connection_string_here

# Logging
LOG_LEVEL=INFO

QDRANT_URL=
QDRANT_API_KEY=

# Langfuse Observability (optional)
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Application environment (used to tag traces in Langfuse)
APP_ENV=local
